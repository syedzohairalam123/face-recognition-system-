# ============================================================
# Face Recognition Attendance System
# Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── Flask ─────────────────────────────────────────────────────
# Secret key for session signing (CHANGE THIS IN PRODUCTION)
SECRET_KEY=your-super-secret-key-change-this

# Database URL (SQLite default, use PostgreSQL for production)
# DATABASE_URL=sqlite:///data/attendance.db
# DATABASE_URL=postgresql://user:pass@localhost:5432/attendance

# ── Face Recognition ──────────────────────────────────────────
# Detection model: "hog" (CPU, faster) or "cnn" (GPU, more accurate)
FACE_DETECTION_MODEL=hog

# Matching tolerance: lower = stricter (0.4–0.6 recommended)
FACE_RECOGNITION_TOLERANCE=0.5

# Embedding model: "small" (faster) or "large" (more accurate)
FACE_RECOGNITION_MODEL=small

# ── Attendance Rules ──────────────────────────────────────────
# Check-ins after this time are marked "late" (HH:MM format)
ATTENDANCE_LATE_AFTER=09:15

# Minutes between allowed check-ins for same user
ATTENDANCE_WINDOW_MINUTES=60

# Seconds of grace period after late_after before marking late
ATTENDANCE_GRACE_PERIOD_SECONDS=30

# ── Camera ────────────────────────────────────────────────────
# Camera device index (0 = default camera)
CAMERA_INDEX=0

# Capture resolution
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=30

# ── Security ──────────────────────────────────────────────────
# API key for mutating API endpoints (optional, leave empty for dev)
# API_KEY=your-api-key-here

# ── Notifications (Optional) ──────────────────────────────────
# Set to "true" to enable email notifications
NOTIFICATIONS_ENABLED=false

# SMTP configuration
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# Sender email address
MAIL_DEFAULT_SENDER=attendance@yourcompany.com

# Admin notification recipients (comma-separated)
ADMIN_NOTIFICATION_EMAILS=admin1@yourcompany.com,admin2@yourcompany.com

# ── Logging ───────────────────────────────────────────────────
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
